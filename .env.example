# 复制为 .env 后使用；生产环境必须替换所有默认口令。
COMPOSE_PROJECT_NAME=baremetal-manager
HTTP_PORT=8080
HAPROXY_STATS_PORT=8404

POSTGRES_DB=bmm_target
POSTGRES_USER=bmm_owner
POSTGRES_VOLUME=baremetal-manager-target-pgdata
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine

MINIO_ROOT_USER=bmm-minio
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
MINIO_BUCKET=baremetal-images
# 可覆盖为私有 MinIO 兼容镜像，例如 registry.example.com/infra/minio:RELEASE.2026-01-01
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest

# 迁移账户为表 owner，运行账户为最小权限角色；两者禁止混用。
# 密码含 @、:、/ 等特殊字符时按 URL 规则编码。
DATABASE_MIGRATION_URL=postgresql://bmm_owner:replace-with-strong-password@postgres:5432/bmm_target
DATABASE_APP_USER=bmm_app
DATABASE_APP_PASSWORD=replace-with-strong-app-password
DATABASE_URL=postgresql://bmm_app:replace-with-strong-app-password@postgres:5432/bmm_target
REDIS_URL=redis://redis:6379/0
# 生成各不相同的高强度随机值；生产环境不要使用示例值。
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
BMC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
# 外部域名部署时改成浏览器实际访问的 scheme://host[:port]。
SOL_ALLOWED_ORIGIN=http://localhost:8080
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=bmm-minio
MINIO_SECRET_KEY=replace-with-strong-minio-password
# ISO、固件、系统镜像文件存储在 MinIO 桶中；OCI 容器镜像必须使用独立 OCI registry。
# MinIO 不是 OCI registry；如需统一底层存储，可另行配置 registry 的 S3 驱动指向 MinIO。
# 多机时各节点通过以上变量连接外部共享 HA PostgreSQL/Redis/MinIO，
# 不要使用各节点本地 postgres-data/redis-data/minio-data 卷作为共享存储。
# 每节点使用独立 COMPOSE_PROJECT_NAME 运行 docker compose up -d --no-deps
# backend-1 backend-2 worker frontend-1 frontend-2 lb；scheduler 只在一个节点运行，
# 或由应用实现分布式锁后再扩容；在独立基础设施中预建 MinIO bucket，
# 并由外部 LB 转发至各节点 HTTP_PORT。
# Compose 只管理单台宿主机，不负责跨节点调度；生产应使用 TLS 和独立密钥管理。
BACKEND_IMAGE=baremetal-manager/backend:latest
FRONTEND_IMAGE=baremetal-manager/frontend:latest
HAPROXY_IMAGE=haproxy:3.0-alpine
DNSMASQ_IMAGE=alpine:3.20
LOG_LEVEL=info
# backend/Dockerfile 的入口为 /app/server，以下为模式参数。
WORKER_COMMAND=worker
SCHEDULER_COMMAND=scheduler

# === 种子数据 ===
# 是否在首次启动时初始化默认数据（角色权限、系统设置等）
SEED_DATA=false

# === 告警推送渠道 ===
# 企业微信机器人 Webhook 地址
ALERT_WECHAT_WEBHOOK=
# 钉钉机器人 Webhook 地址
ALERT_DINGTALK_WEBHOOK=
# 通用 Webhook 地址
ALERT_WEBHOOK_URL=
# SMTP 邮件服务器地址
ALERT_SMTP_HOST=
# SMTP 端口
ALERT_SMTP_PORT=587
# SMTP 用户名
ALERT_SMTP_USER=
# SMTP 密码
ALERT_SMTP_PASS=

# === 传感器采集 ===
# 默认采集间隔（秒）
SENSOR_INTERVAL=300

# === BMC 管理 ===
# BMC 最大并发连接数
BMC_MAX_CONCURRENT=10

# === SOL 串口控制台 ===
# 会话超时时间（分钟）
SOL_SESSION_TIMEOUT=15
# 仅记录会话元信息，禁止记录串口正文
SOL_LOG_ENABLED=false

# === PXE 网络引导 ===
# DHCP 服务地址范围
PXE_DHCP_RANGE=192.168.1.100-192.168.1.200
# TFTP 根目录
PXE_TFTP_ROOT=/var/lib/tftpboot
# HTTP 启动服务地址
PXE_HTTP_BASE=http://pxe.example.com
